{
  "name": "mohonaut",
  "private": true,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "knip": "^5.88.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
