# Deploy configuration for script/Deploy.s.sol. Copy to contracts/.env (never committed) or export.
# NO PRIVATE KEYS HERE. The deployer signs with a Foundry keystore (`cast wallet import deployer
# --interactive`, then `--account deployer`) or a hardware wallet (`--ledger`).

# Genesis: an exact UTC hour boundary in the future (unix seconds). Pre-fill opens 24 h before it,
# Market Open is 72 h after it. Mainnet: no earlier than 30 days after the domain was registered.
GENESIS_TIME=

# Ops Safe: proposes to both Timelocks (96 h parameters, 7 days upgrades) and pulls the ops bucket.
OPS_SAFE=
# Guardian Safe: may pause player actions for at most 72 hours, nothing else.
GUARDIAN_SAFE=
# Keeper: hot key on the server (poke, finalize, capped buyback/liquidity, testnet price feed).
KEEPER=
DEV_RECIPIENT=
TREASURY_RECIPIENT=

# Chainlink ETH/USD proxy. Mainnet: 0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9.
# Leave empty on testnet: a keeper-owned ManualEthUsdFeed is deployed (refused on mainnet).
ETH_USD_FEED=

# Optional: Uniswap v4 PoolManager (default: 0x8366a39CC670B4001A1121B8F6a443A643e40951, both nets).
# POOL_MANAGER=

# Optional: set to false to skip writing deployments/<chainId>.json.
# WRITE_DEPLOYMENT=true
