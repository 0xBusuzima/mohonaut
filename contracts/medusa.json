{
  "fuzzing": {
    "workers": 8,
    "timeout": 21600,
    "callSequenceLength": 100,
    "corpusDirectory": "medusa-corpus",
    "targetContracts": [
      "CryticTester",
      "CryticMarketTester"
    ],
    "testing": {
      "assertionTesting": {
        "enabled": true
      },
      "propertyTesting": {
        "enabled": true,
        "testPrefixes": [
          "invariant_"
        ]
      }
    },
    "chainConfig": {
      "codeSizeCheckDisabled": true,
      "cheatCodes": {
        "cheatCodesEnabled": true,
        "enableFFI": false
      }
    },
    "blockTimestampDelayMax": 86400
  },
  "compilation": {
    "platform": "crytic-compile",
    "platformConfig": {
      "target": ".",
      "args": [
        "--foundry-compile-all"
      ]
    }
  }
}
