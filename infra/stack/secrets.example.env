# What the back end reads, with placeholders only. The real file is encrypted with SOPS + age
# (secrets.testnet.enc.env / secrets.mainnet.enc.env, see infra/RUNBOOK.md) and decrypted by
# deploy.sh into /run/mohonaut/stack.env (memory only, root-readable). Never commit a decrypted
# copy. Files that are secrets themselves (Postgres password, keeper keystore and password)
# live in /etc/mohonaut/secrets/ on the server.

# Shared
RPC_URL=https://rpc.testnet.chain.robinhood.com
DATABASE_URL=postgres://mohonaut:CHANGE_ME@postgres:5432/mohonaut
DEPLOYMENT_FILE=/deployments/46630.json

# API (services/api/.env.example)
WEB_ORIGIN=https://mohonaut.com
SURVEY_SECRET=CHANGE_ME_64_HEX
TURNSTILE_SECRET=CHANGE_ME
ADMIN_WALLETS=0x0000000000000000000000000000000000000000

# Indexer (services/indexer/.env.example): the defaults suit production.

# Keeper (services/keeper/.env.example); its keystore and password are files.
DRY_RUN=false
JOBS=feed,poke,openMarket,finalize,buyback,addLiquidity

# Cloudflare Tunnel (Zero Trust → Networks → Tunnels → the tunnel's token)
TUNNEL_TOKEN=CHANGE_ME
