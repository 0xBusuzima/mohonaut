{
  "uid": "mohonaut-indexer",
  "title": "Indexer",
  "tags": [
    "mohonaut"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Blocks behind head",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "indexer_head_block - ignoring(stream) indexer_block",
          "legendFormat": "{{stream}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Events indexed / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (contract) (rate(indexer_events_total[5m])) * 60",
          "legendFormat": "{{contract}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Projected RPC compute units / month",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(indexer_rpc_compute_units_total[6h]) * 86400 * 30",
          "legendFormat": "projected"
        },
        {
          "refId": "B",
          "expr": "vector(30e6)",
          "legendFormat": "free tier"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "RPC requests / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(indexer_rpc_requests_total[5m])) * 60",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "On-chain alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "indexer_alerts_pending",
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "expr": "increase(indexer_alerts_sent_total[1h])",
          "legendFormat": "sent / h"
        },
        {
          "refId": "C",
          "expr": "increase(indexer_alert_failures_total[1h])",
          "legendFormat": "failed / h"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Seconds since last successful poll",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - indexer_last_success_timestamp_seconds",
          "legendFormat": "age"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Indexer logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\".*indexer.*\"}"
        }
      ]
    }
  ]
}
