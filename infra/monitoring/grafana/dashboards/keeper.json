{
  "uid": "mohonaut-keeper",
  "title": "Keeper",
  "tags": [
    "mohonaut"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Keeper balance (ETH)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "keeper_balance_wei / 1e18",
          "legendFormat": "balance"
        },
        {
          "refId": "B",
          "expr": "vector(0.002)",
          "legendFormat": "alert"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Hours since last success",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - keeper_last_success_timestamp_seconds) / 3600",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Transactions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(keeper_tx_total[1h])",
          "legendFormat": "{{task}} {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Errors and price-guard skips",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(keeper_errors_total[1h])",
          "legendFormat": "error {{task}}"
        },
        {
          "refId": "B",
          "expr": "increase(keeper_guard_trips_total[1h])",
          "legendFormat": "guard {{task}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Lock holder",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "keeper_lock_held",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Keeper logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\".*keeper.*\"}"
        }
      ]
    }
  ]
}
