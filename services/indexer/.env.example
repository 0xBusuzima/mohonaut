# Copy to .env (never commit it). See services/indexer/README.md.
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Production: postgres://user:password@host:5432/mohonaut. Local: pglite://./data/indexer
DATABASE_URL=pglite://./data/indexer
DEPLOYMENT_FILE=../../deployments/46630.json
POLL_INTERVAL_MS=10000
CONFIRMATIONS=20
MAX_BLOCK_RANGE=50000
POOL_POLL_EVERY=6
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
# On-chain alerts (ADR-014). Token file outside the repository; chat id is not a secret.
# ALERT_TELEGRAM_TOKEN_FILE=/etc/mohonaut/secrets/telegram_bot_token
# ALERT_TELEGRAM_CHAT_ID=-100...
# ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=warning
ALERT_MAX_AGE_S=86400
LARGE_TRANSFER_MOHN=50000
