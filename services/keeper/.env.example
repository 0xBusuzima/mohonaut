# Copy to .env (never commit it). See services/keeper/README.md.
RPC_URL=https://rpc.testnet.chain.robinhood.com
# The indexer's database. One machine: an embedded PGlite directory and RUN_INDEXER=true.
# Server: the indexer's Postgres URL and RUN_INDEXER=false (the indexer runs separately).
DATABASE_URL=pglite://./data/keeper
RUN_INDEXER=true
DEPLOYMENT_FILE=../../deployments/46630.json
# Preferred: an encrypted Foundry keystore (cast wallet import keeper --interactive).
# The password is typed at start, or read from KEEPER_PASSWORD_FILE (a file outside the repo).
KEEPER_KEYSTORE=
# KEEPER_PASSWORD_FILE=
# Alternative for servers: the raw key injected by the secret manager (never in a file in the repo).
# KEEPER_PRIVATE_KEY=
# Simulate everything from the deployment's keeper, send nothing (no key needed).
DRY_RUN=false
TICK_INTERVAL_MS=60000
JOBS=feed,poke,openMarket,finalize,buyback,addLiquidity
DAILY_JOBS_HOUR_UTC=12
SLIPPAGE_BPS=100
MAX_PRICE_DEVIATION_BPS=1000
MIN_DAILY_SPEND_WEI=1000000000000
FEED_REFRESH_AFTER_S=72000
METRICS_HOST=127.0.0.1
METRICS_PORT=9465
