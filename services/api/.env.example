# Copy to .env (never commit it). See services/api/README.md.
NODE_ENV=development
# The indexer's database (one machine: the same PGlite directory cannot be opened twice; use Postgres
# when the indexer and the API run at the same time).
DATABASE_URL=postgres://mohonaut:password@127.0.0.1:5432/mohonaut
# REDIS_URL=redis://127.0.0.1:6379
DEPLOYMENT_FILE=../../deployments/46630.json
RPC_URL=https://rpc.testnet.chain.robinhood.com
WEB_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=8787
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SURVEY_SECRET=
# TURNSTILE_SECRET=
TRUST_CLOUDFLARE=false
# Comma-separated wallets that always hold the admin role.
ADMIN_WALLETS=
# Optional e-mail login (Dynamic or Privy): all four or none.
# EXTERNAL_AUTH_NAME=privy
# EXTERNAL_AUTH_ISSUER=privy.io
# EXTERNAL_AUTH_AUDIENCE=
# EXTERNAL_AUTH_JWKS_URL=
