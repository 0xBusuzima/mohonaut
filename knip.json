{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["contracts/**"],
  "workspaces": {
    ".": { "entry": [], "project": [] },
    "packages/config": {},
    "packages/sdk": { "entry": ["src/index.ts"], "project": ["src/**/*.ts", "test/**/*.ts"] },
    "apps/*": { "entry": ["src/index.ts"], "project": ["src/**/*.ts", "test/**/*.ts"] },
    "services/*": { "entry": ["src/index.ts"], "project": ["src/**/*.ts", "test/**/*.ts"] }
  }
}
